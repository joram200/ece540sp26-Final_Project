  .s_axis_txc(s_axis_txc.slave), // vivado_axis_v1_0.slave s_axis_txc
  .m_axis_rxd(m_axis_rxd.master), // vivado_axis_v1_0.master m_axis_rxd
  .m_axis_rxs(m_axis_rxs.master), // vivado_axis_v1_0.master m_axis_rxs
  .s_axi_lite_resetn(s_axi_lite_resetn), // input wire s_axi_lite_resetn
  .s_axi_lite_clk(s_axi_lite_clk), // input wire s_axi_lite_clk
  .mac_irq(mac_irq), // output wire mac_irq
