<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 5.4-c002 1.000000, 0000/00/00-00:00:00        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>This core implements a tri-mode (10/100/1000 Mbps) Ethernet MAC or a 10/100 Mbps Ethernet MAC, supports most popular PHY interfaces, optionally supports Ethernet AVB (Audio Video Bridging) functions, and provides a control interface to internal registers via a 32-bit AXI4-Lite Interface subset.</rdf:li>
               <rdf:li>zynq,vivado,ethernet,kintex,virtex,spartan,k7,v7,v6,s6,xilinx,IP,cores,axi,axi4,axi-stream,axii4-lite,ethernet,mac,100basex,sgmii,avb </rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-repair">This core implements a tri-mode (10/100/1000 Mbps) Ethernet MAC or a 10/100 Mbps Ethernet MAC, supports most popular PHY interfaces, optionally supports Ethernet AVB (Audio Video Bridging) functions, and provides a control interface to internal registers via a 32-bit AXI4-Lite Interface subset.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:modified>2013-03-10T16:59:55.438-07:00</dc:modified>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>Xilinx, Inc.</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-repair">Xilinx DS759 LogiCORE IP AXI Ethernet (v3.01a), Data Sheet</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
